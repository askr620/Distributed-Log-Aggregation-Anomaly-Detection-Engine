# Environment variable template.
# Copy this file to .env for local use.
# For a real website/application, change the values marked "CHANGE FOR REAL APP".

# =========================
# Kafka - KEEP for Docker local
# =========================
# Used by ingestion, consumers, and dashboard to connect to Kafka.
# Keep kafka:9092 when Kafka runs inside this docker-compose project.
# Change only if Kafka is hosted somewhere else.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Kafka topic names - usually KEEP
# LOG_TOPIC stores raw logs. ANOMALY_TOPIC stores detected anomaly events.
LOG_TOPIC=raw-logs
ANOMALY_TOPIC=anomaly-events

# =========================
# Redis - KEEP for Docker local
# =========================
# Used by anomaly detection for rolling counts and alert cooldown.
# Keep this when Redis runs inside docker-compose.
REDIS_URL=redis://redis:6379/0

# =========================
# Database - CHANGE PASSWORD FOR REAL APP
# =========================
# TimescaleDB/PostgreSQL settings.
# CHANGE FOR REAL APP: POSTGRES_PASSWORD must be strong and private.
POSTGRES_USER=loguser
POSTGRES_PASSWORD=logpass
POSTGRES_DB=logsdb

# CHANGE FOR REAL APP if you change database password or use an external database.
DATABASE_URL=postgresql+asyncpg://loguser:logpass@timescaledb:5432/logsdb

# =========================
# API Auth - CHANGE FOR REAL APP
# =========================
# Your real website/backend must send this value in the X-API-Key header.
# CHANGE FOR REAL APP: use a long random secret.
API_KEY=super-secret-key-123

# =========================
# Anomaly Detection - TUNE FOR REAL APP
# =========================
# WINDOW_SIZE_SECONDS: counting window size.
# Z_SCORE_THRESHOLD: lower = more sensitive, higher = fewer alerts.
# MIN_SAMPLES: previous non-zero windows needed before detection starts.
# ALERT_COOLDOWN_SECONDS: prevents duplicate alerts too frequently.
WINDOW_SIZE_SECONDS=30
Z_SCORE_THRESHOLD=2.5
MIN_SAMPLES=3
ALERT_COOLDOWN_SECONDS=180

# =========================
# Dashboard Auth - CHANGE FOR REAL APP
# =========================
# CHANGE FOR REAL APP: use strong dashboard username/password/token.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
DASHBOARD_TOKEN=change-me-token

# =========================
# Alerting - OPTIONAL FOR REAL APP
# =========================
# Slack alerting is optional.
# If empty, Slack alerts will not be sent.
SLACK_WEBHOOK_URL=

# Email alerting is optional.
# SMTP_HOST=localhost means real email delivery is not configured.
# CHANGE FOR REAL APP if you want real email alerts.
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=you@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# =========================
# AI Incident Analyzer - OPTIONAL
# =========================
# When set, anomaly events are automatically analyzed by an LLM.
# The AI returns a root cause summary and recommended checks.
# Leave empty to disable AI analysis (system works fine without it).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# =========================
# Used only by mock_services when running demo mode:
# docker compose --profile demo up -d --build
# Real websites/apps do not use this value. A real app sends logs directly to:
# http://your-log-engine-host:8000/logs
INGESTION_URL=http://ingestion:8000
